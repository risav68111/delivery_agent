NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/delivery_agents

# Optional: pool tuning
# DB_POOL_MAX=10
# DB_SSL=false

# Redis cache
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=0
REDIS_KEY_PREFIX=dam
# REDIS_ENABLED=true
# CACHE_LIST_TTL_SECONDS=60
# CACHE_DETAIL_TTL_SECONDS=120
# CACHE_STATS_TTL_SECONDS=60
# CACHE_NEGATIVE_TTL_SECONDS=10

# Browser origins allowed to call the API (comma separated, or * for any)
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Admin account created on first boot when no admin exists
ADMIN_NAME=Operations Admin
ADMIN_EMAIL=admin@dispatch.local
ADMIN_PASSWORD=Admin@12345
# Session lifetime in seconds (sliding) and cookie name
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=dispatch.sid
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
